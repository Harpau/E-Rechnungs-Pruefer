# Lokaler HTTP-Server
HOST=127.0.0.1
PORT=8080
# HTTP-Dateibudget: 1..26214400 Byte (25 MiB); kleinere Grenzen sind zulässig.
# Der gesamte Multipart-Body darf zusätzlich höchstens 65536 Byte Metadaten enthalten.
# Ungültige Werte können schon den Start verhindern; eine größere positive Grenze
# wird vor dem HTTP-Bodylesen mit 503 abgewiesen.
MAX_UPLOAD_BYTES=26214400
MAX_TECHNICAL_ROWS=100000
MAX_XML_STRUCTURE_ITEMS=100000
MAX_TECHNICAL_SECONDS=5.0

# Optionale offizielle KoSIT-Prüfung
# Der Installer scripts/install_kosit.py erzeugt normalerweise .env.kosit automatisch.
KOSIT_ENABLED=true
KOSIT_JAVA_BIN=java
KOSIT_VALIDATOR_JAR=vendor/kosit/validator/validator-1.6.3-standalone.jar
KOSIT_SCENARIOS=vendor/kosit/xrechnung/scenarios.xml
KOSIT_REPOSITORIES=vendor/kosit/xrechnung
# Ganzzahlige KoSIT-Frist 1..300 Sekunden. HTTP-Jobfrist: 60 s + diese Frist
# bei angeforderter offizieller Prüfung; Upload und Antwort haben eigene Fristen.
KOSIT_TIMEOUT_SECONDS=60

# Weitere feste HTTP-/Workerbudgets werden nicht aus Umgebungsvariablen übernommen.
# Zwei Auftragsplätze je Backendprozess umfassen Upload, Verarbeitung und Antwort.
# Mehrere uvicorn --workers vervielfachen diese Grenzen; siehe docs/SECURITY_MODEL.md.
